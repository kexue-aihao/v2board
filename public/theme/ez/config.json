{
  "name": "ez",
  "description": "EZ Theme adapted for V2Board",
  "version": "0.3.8-v2board",
  "images": "",
  "configs": [
    {
      "label": "Theme color",
      "placeholder": "Choose a theme color",
      "field_name": "theme_color",
      "field_type": "select",
      "select_options": {
        "default": "Default",
        "green": "Green",
        "black": "Black",
        "darkblue": "Dark blue"
      },
      "default_value": "default"
    },
    {
      "label": "Background URL",
      "placeholder": "Optional same-origin background image URL",
      "field_name": "background_url",
      "field_type": "input"
    },
    {
      "label": "Custom HTML",
      "placeholder": "Optional footer HTML",
      "field_name": "custom_html",
      "field_type": "textarea"
    }
  ]
}
